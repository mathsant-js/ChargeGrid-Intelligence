APP_ENV=development
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS=["http://localhost:5173"]
JWT_SECRET_KEY=development-only-change-me-minimum-32-bytes
JWT_EXPIRATION_MINUTES=60
JWT_ALGORITHM=HS256
GRID_EMISSION_FACTOR_KG_PER_KWH=0.0
# Deterministic clock for a fresh demo database only; also set APP_ENV=demo:
# DEMO_SIMULATION_START_UTC=2026-09-18T11:58:00Z

POSTGRES_DB=chargegrid
POSTGRES_USER=chargegrid
POSTGRES_PASSWORD=chargegrid
DATABASE_URL=postgresql+psycopg://chargegrid:chargegrid@localhost:5432/chargegrid

VITE_API_URL=http://localhost:8000/api/v1
